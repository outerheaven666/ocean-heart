{
  "installCommand": "npm ci --include=dev && npm --prefix server ci --include=dev && npm --prefix app ci --include=dev",
  "buildCommand": "npm --prefix app run build",
  "outputDirectory": "app/dist",
  "rewrites": [
    { "source": "/trpc/:path*", "destination": "/api/trpc/:path*" },
    { "source": "/img/:path*", "destination": "/api/img" },
    { "source": "/((?!api|assets|favicon|img|robots\\.txt|sitemap\\.xml).*)", "destination": "/index.html" }
  ]
}
